<?xml version="1.0" ?>
<robot name="Biped_Robot_Master" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="J01_Left_Hip_Roll_Y_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="J01_Left_Hip_Roll_Y">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="J01_Left_Hip_Roll_Y_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

