# Large generated artifacts: datasets, checkpoints, logs, videos
outputs/
*.h5
*.hdf5
*.npz
*.pt
*.pth
*.onnx
*.mp4
events.out.tfevents.*

# Reference CAD / meshes (kept locally, not versioned; exp1 needs them on disk)
references/**/*.f3d
references/**/*.stl
*.STL

# Generated USD (rebuild from URDF)
simulation/robot_assets/usd/
**/shared/robots/usd/

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.claude/settings.local.json

# Third-party servo CAD / vendor files (downloaded locally; licences CC BY-NC-SA etc., re-download from links in the README)
hardware/design_refs/hd1910/cad/
*.xlsx
hardware/design_refs/hd1910/vendor/fddebug/

# CAD Python environment (uv + build123d), kept inside the project but not versioned
tools/bin/
.uv/
.venv_cad/
.venv_fw/

# Robot model versions keep their print files and visual meshes (a few MB, needed to rebuild a tagged version)
!hardware/robot_v*/parts/stl/*.stl
!hardware/robot_v*/meshes/*.stl

# Curated, compressed evaluation videos (git LFS, see docs/videos/README.md)
!docs/videos/**/*.mp4

# Teammate MANGO X4 handoff (4.1 GB, read-only reference; copy needed files into deploy/ with provenance)
references/mango_x4_handoff_20261117/
